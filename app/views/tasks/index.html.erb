<body style="background-color: #cbd2d3; display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh; margin: 0; font-family: sans-serif;">

  <!-- หัวข้ออยู่กึ่งกลาง ด้านบนการ์ด -->
  <h1 style="font-size: 2.5rem; color: #0c131d; margin-top: 0; margin-bottom: 20px; text-align: center;">TO DO LIST </h1>

  <!-- Card Container -->
  <div style="background-color: #ffffff; padding: 40px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1); width: 100%; max-width: 800px; box-sizing: border-box;">
    
    <turbo-frame id="tasks">
      <% if @tasks.present? %>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% @tasks.each do |t| %>
            <!-- จัดเรียงให้ชื่ออยู่ซ้าย ปุ่มดูรายละเอียดอยู่ขวา -->
            <div style="padding: 12px 16px; background-color: #f3f4f6; border-radius: 8px; border: 1px solid #e5e7eb; color: #374151; font-size: 1rem; display: flex; justify-content: space-between; align-items: center;">
              <span><%= t.title %></span>
              
              <!-- ปุ่มดูรายละเอียด -->
              <%= link_to "ดูรายละเอียด", task_path(t), style: "padding: 6px 12px; background-color: #4b5563; color: white; text-decoration: none; border-radius: 6px; font-size: 0.875rem; font-weight: 500;" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="text-align: center;">
          <%= link_to "Load tasks", tasks_path, style: "display: inline-block; padding: 12px 24px; background-color: #906af9; color: white; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 1rem;" %>
        </div>
      <% end %>
    </turbo-frame>

  </div>

</body>
